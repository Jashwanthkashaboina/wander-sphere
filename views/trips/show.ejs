<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <div id="tripDetails">
        <h1>My Trip</h1>
        <p class="text-muted">Loading your itinerary...</p>
    </div>

    <div id="itineraryContainer"></div>

</div>


<script>

const tripId = "<%= tripId %>";


async function loadItinerary() {

    try {

        const response = await fetch(
            `/api/trips/${tripId}/itinerary`
        );

        const result = await response.json();

        if (!response.ok) {
            throw new Error(
                result.message || "Unable to fetch itinerary"
            );
        }

        const itinerary = result.itinerary;


        // Trip Summary

        document.getElementById("tripDetails").innerHTML = `

            <h1>My Trip</h1>

            <p class="text-muted">
                Your personalized itinerary
            </p>

            <div class="card p-3 mb-4">

                <h4>Trip Summary</h4>

                <p>
                    <strong>Total Activity Cost:</strong>
                    ₹${itinerary.totalCost}
                </p>

                <p>
                    <strong>Stability Score:</strong>
                    ${itinerary.stabilityScore}
                </p>

            </div>

        `;


        const container =
            document.getElementById("itineraryContainer");


        // Days

        itinerary.days.forEach((day, index) => {

            let activitiesHTML = "";


            if (day.activities.length === 0) {

                activitiesHTML = `
                    <p class="text-muted">
                        No activities planned for this day.
                    </p>
                `;

            } else {

                activitiesHTML = day.activities.map(activity => `

                    <div class="card mb-3 p-3">

                        <h5>
                            ${activity.poiId.name}
                        </h5>

                        <p class="mb-1">
                            <strong>Category:</strong>
                            ${activity.poiId.category}
                        </p>

                        <p class="mb-1">
                            <strong>Time:</strong>
                            ${formatTime(activity.startTime)}
                            -
                            ${formatTime(activity.endTime)}
                        </p>

                        <p class="mb-1">
                            <strong>Travel Time:</strong>
                            ${activity.travelTime} minutes
                        </p>

                        <p class="mb-3">
                            <strong>Cost:</strong>
                            ₹${activity.estimatedCost}
                        </p>
                        
                        
                        <button
                            class="btn btn-outline-danger btn-sm"
                            onclick="removeActivity(
                                '${tripId}',
                                '${activity.poiId._id}'
                            )"
                        >
                            Remove Activity
                        </button>

                    </div>
                `).join("");

            }

            const regenerateButton = `
                                    <button
                                        class="btn btn-outline-primary btn-sm mb-3"
                                        onclick="regenerateDay(${index})"
                                    >
                                        Regenerate Day
                                    </button>
            `;


            container.innerHTML += `

                <div class="mb-5">

                    <h3>
                        Day ${index + 1}
                    </h3>

                    <p class="text-muted">
                        ${new Date(day.date).toDateString()}
                    </p>
                    
                    ${regenerateButton}

                    ${activitiesHTML}

                    <div class="text-end">

                        <strong>
                            Day Cost: ₹${day.dailyCost}
                        </strong>

                    </div>

                </div>

            `;

        });


    } catch (error) {

        console.error(
            "Itinerary Loading Error:",
            error
        );

        document.getElementById(
            "itineraryContainer"
        ).innerHTML = `

            <div class="alert alert-danger">
                ${error.message}
            </div>

        `;

    }

}



async function removeActivity(tripId, poiId) {

    const confirmed = confirm(
        "Are you sure you want to remove this activity?"
    );

    if (!confirmed) {
        return;
    }


    try {

        const response = await fetch(
            `/api/trips/${tripId}/itinerary/${poiId}`,
            {
                method: "DELETE"
            }
        );


        const result = await response.json();


        if (!response.ok) {

            alert(
                result.message ||
                "Unable to remove activity"
            );

            return;

        }


        alert("Activity removed successfully");


        // Reload updated itinerary

        location.reload();


    } catch (error) {

        console.error(
            "Remove Activity Error:",
            error
        );

        alert(
            "Something went wrong while removing the activity"
        );

    }

}



function formatTime(minutes) {

    const hours = Math.floor(minutes / 60);

    const mins = minutes % 60;

    const period =
        hours >= 12 ? "PM" : "AM";

    let displayHour =
        hours % 12;

    if (displayHour === 0) {
        displayHour = 12;
    }

    return `${displayHour}:${String(mins).padStart(2, "0")} ${period}`;

}


async function regenerateDay(dayIndex) {

    const confirmed = confirm(
        `Regenerate Day ${dayIndex + 1}?`
    );

    if (!confirmed) return;

    const response = await fetch(
        `/api/trips/${tripId}/itinerary/${dayIndex}/regenerate`,
        {
            method: "POST"
        }
    );

    const result = await response.json();

    if (!response.ok) {
        alert(result.message || "Unable to regenerate day");
        return;
    }

    alert("Day regenerated successfully");

    location.reload();
}


loadItinerary();

</script>