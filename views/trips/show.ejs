<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <div id="tripDetails">
        <h1>My Trip</h1>
        <p class="text-muted">Loading your trip...</p>
    </div>

    <!-- Hotel Recommendations -->
    <div id="hotelRecommendations" class="mb-5"></div>

    <!-- Show Selected Hotels -->
    <div id="selectedHotel" class="mb-5"></div>


    <!-- Itinerary -->
    <div id="itineraryContainer"></div>

</div>


<script>

const tripId = "<%= tripId %>";


// =====================================================
// LOAD TRIP + ITINERARY
// =====================================================

async function loadItinerary() {

    try {

        const response = await fetch(
            `/api/trips/${tripId}/itinerary`
        );

        const result = await response.json();

        if (!response.ok) {
            throw new Error(
                result.message || "Unable to fetch itinerary"
            );
        }

        const itinerary = result.itinerary;


        // Trip Summary

        document.getElementById("tripDetails").innerHTML = `

            <h1>My Trip</h1>

            <p class="text-muted">
                Your personalized itinerary
            </p>

            <div class="card p-3 mb-4">

                <h4>Trip Summary</h4>

                <p>
                    <strong>Total Activity Cost:</strong>
                    ₹${itinerary.totalCost}
                </p>

                <p>
                    <strong>Stability Score:</strong>
                    ${itinerary.stabilityScore}
                </p>

            </div>

        `;


        const container =
            document.getElementById("itineraryContainer");


        // Clear container before rendering

        container.innerHTML = "";


        // Days

        itinerary.days.forEach((day, index) => {

            let activitiesHTML = "";


            if (day.activities.length === 0) {

                activitiesHTML = `
                    <p class="text-muted">
                        No activities planned for this day.
                    </p>
                `;

            } else {

                activitiesHTML = day.activities.map(activity => `

                    <div class="card mb-3 p-3">

                        <h5>
                            ${activity.poiId.name}
                        </h5>

                        <p class="mb-1">
                            <strong>Category:</strong>
                            ${activity.poiId.category}
                        </p>

                        <p class="mb-1">
                            <strong>Time:</strong>
                            ${formatTime(activity.startTime)}
                            -
                            ${formatTime(activity.endTime)}
                        </p>

                        <p class="mb-1">
                            <strong>Travel Time:</strong>
                            ${activity.travelTime} minutes
                        </p>

                        <p class="mb-3">
                            <strong>Cost:</strong>
                            ₹${activity.estimatedCost}
                        </p>

                        <button
                            class="btn btn-outline-danger btn-sm"
                            onclick="removeActivity(
                                '${tripId}',
                                '${activity.poiId._id}'
                            )"
                        >
                            Remove Activity
                        </button>

                    </div>

                `).join("");

            }


            const regenerateButton = `
                <button
                    class="btn btn-outline-primary btn-sm mb-3"
                    onclick="regenerateDay(${index})"
                >
                    Regenerate Day
                </button>
            `;


            container.innerHTML += `

                <div class="mb-5">

                    <h3>
                        Day ${index + 1}
                    </h3>

                    <p class="text-muted">
                        ${new Date(day.date).toDateString()}
                    </p>

                    ${regenerateButton}

                    ${activitiesHTML}

                    <div class="text-end">

                        <strong>
                            Day Cost: ₹${day.dailyCost}
                        </strong>

                    </div>

                </div>

            `;

        });


    } catch (error) {

        console.error(
            "Itinerary Loading Error:",
            error
        );

        document.getElementById(
            "itineraryContainer"
        ).innerHTML = `

            <div class="alert alert-danger">
                ${error.message}
            </div>

        `;

    }

}



// =====================================================
// LOAD HOTEL RECOMMENDATIONS
// =====================================================

async function loadHotelRecommendations() {

    try {

        const response = await fetch(
            `/api/trips/${tripId}/recommended-hotels`
        );

        const result = await response.json();

        if (!response.ok) {

            throw new Error(
                result.message ||
                "Unable to fetch hotel recommendations"
            );

        }


        const container =
            document.getElementById(
                "hotelRecommendations"
            );


        if (
            !result.recommendations ||
            result.recommendations.length === 0
        ) {

            container.innerHTML = `

                <div class="alert alert-warning">
                    No suitable hotels found for this trip.
                </div>

            `;

            return;

        }


        let hotelsHTML = `

            <h2 class="mb-3">
                Recommended Hotels
            </h2>

            <p class="text-muted">
                Hotels ranked based on your budget and itinerary.
            </p>

            <div class="row">

        `;


        result.recommendations.forEach(
            recommendation => {

                const hotel =
                    recommendation.hotel;


                hotelsHTML += `

                    <div class="col-md-6 col-lg-4 mb-4">

                        <div class="card h-100 shadow-sm">

                            <img
                                src="${hotel.image.url}"
                                class="card-img-top"
                                alt="${hotel.title}"
                                style="
                                    height: 220px;
                                    object-fit: cover;
                                "
                            >

                            <div class="card-body">

                                <h5 class="card-title">
                                    ${hotel.title}
                                </h5>

                                <p class="text-muted mb-2">
                                    ${hotel.location}
                                </p>

                                <p class="mb-2">

                                    <strong>
                                        ₹${hotel.price}
                                    </strong>
                                    / night

                                </p>

                                <p class="mb-2">

                                    <strong>
                                        Recommendation Score:
                                    </strong>

                                    ${recommendation.score}

                                </p>

                                <p class="mb-3">

                                    <strong>
                                        Avg Travel Time:
                                    </strong>

                                    ${recommendation.averageTravelTime}
                                    minutes

                                </p>

                                <button
                                    class="btn btn-primary w-100"
                                    onclick="selectHotel(
                                        '${hotel._id}'
                                    )"
                                >
                                    Select Hotel
                                </button>

                            </div>

                        </div>

                    </div>

                `;

            }
        );


        hotelsHTML += `
            </div>
        `;


        container.innerHTML = hotelsHTML;


    } catch (error) {

        console.error(
            "Hotel Recommendation Error:",
            error
        );

        document.getElementById(
            "hotelRecommendations"
        ).innerHTML = `

            <div class="alert alert-danger">
                ${error.message}
            </div>

        `;

    }

}



// =====================================================
// SELECT HOTEL
// =====================================================

async function selectHotel(hotelId) {

    const confirmed = confirm(
        "Do you want to select this hotel?"
    );

    if (!confirmed) {
        return;
    }

    try {

        const response = await fetch(
            `/api/trips/${tripId}/hotel`,
            {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    hotelId: hotelId
                })
            }
        );

        const result = await response.json();

        if (!response.ok) {

            alert(
                result.message ||
                "Unable to select hotel"
            );

            return;
        }

        alert("Hotel selected successfully!");

        location.reload();

    } catch (error) {

        console.error("Select Hotel Error:", error);

        alert("Something went wrong while selecting the hotel");

    }
}



// =====================================================
// REMOVE ACTIVITY
// =====================================================

async function removeActivity(
    tripId,
    poiId
) {

    const confirmed = confirm(
        "Are you sure you want to remove this activity?"
    );

    if (!confirmed) {
        return;
    }


    try {

        const response = await fetch(
            `/api/trips/${tripId}/itinerary/${poiId}`,
            {
                method: "DELETE"
            }
        );


        const result = await response.json();


        if (!response.ok) {

            alert(
                result.message ||
                "Unable to remove activity"
            );

            return;

        }


        alert("Activity removed successfully");


        location.reload();


    } catch (error) {

        console.error(
            "Remove Activity Error:",
            error
        );

        alert("Something went wrong while removing the activity");

    }

}



// =====================================================
// FORMAT TIME
// =====================================================

function formatTime(minutes) {

    const hours =
        Math.floor(minutes / 60);

    const mins =
        minutes % 60;

    const period =
        hours >= 12 ? "PM" : "AM";


    let displayHour =
        hours % 12;


    if (displayHour === 0) {
        displayHour = 12;
    }


    return `${displayHour}:${String(mins).padStart(2, "0")} ${period}`;

}



// =====================================================
// REGENERATE DAY
// =====================================================

async function regenerateDay(dayIndex) {

    const confirmed = confirm(
        `Regenerate Day ${dayIndex + 1}?`
    );

    if (!confirmed) {
        return;
    }


    const response = await fetch(
        `/api/trips/${tripId}/itinerary/${dayIndex}/regenerate`,
        {
            method: "POST"
        }
    );


    const result =
        await response.json();


    if (!response.ok) {

        alert(
            result.message ||
            "Unable to regenerate day"
        );

        return;

    }


    alert(
        "Day regenerated successfully"
    );


    location.reload();

}



async function loadSelectedHotel() {

    try {

        const response = await fetch(
            `/api/trips/${tripId}`
        );

        const trip = await response.json();

        if (!response.ok) {
            throw new Error(
                trip.message || "Unable to fetch trip"
            );
        }

        const container =
            document.getElementById("selectedHotel");

        if (!trip.hotelId) {
            container.innerHTML = "";
            return;
        }

        const hotel = trip.hotelId;

        container.innerHTML = `

            <h2 class="mb-3">
                Selected Hotel
            </h2>

            <div class="card p-3">

                <div class="row align-items-center">

                    <div class="col-md-4">

                        <img
                            src="${hotel.image.url}"
                            class="img-fluid rounded"
                            style="height: 200px; width: 100%; object-fit: cover;"
                            alt="${hotel.title}"
                        >

                    </div>

                    <div class="col-md-8">

                        <h3>
                            ${hotel.title}
                        </h3>

                        <p class="text-muted">
                            ${hotel.location}
                        </p>

                        <p>
                            <strong>
                                ₹${hotel.price}
                            </strong>
                            / night
                        </p>

                        <span class="badge bg-success">
                            Hotel Selected
                        </span>

                        <br>

                        <a
                            href="/listings/${hotel._id}?tripId=${tripId}"
                            class="btn btn-primary"
                        >
                            Book This Hotel
                        </a>

                    </div>

                </div>

            </div>

        `;

    } catch (error) {

        console.error(
            "Selected Hotel Error:",
            error
        );

    }

}



// =====================================================
// INITIAL LOAD
// =====================================================

loadItinerary();

loadHotelRecommendations();

loadSelectedHotel();



</script>