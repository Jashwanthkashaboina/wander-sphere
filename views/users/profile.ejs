<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4 p-4">

                <!-- Profile Header -->
                <div class="text-center">

                    <div 
                        class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                        style="width:100px; height:100px; font-size:2rem;"
                    >
                        <%= currUser.username.split("@")[0].charAt(0).toUpperCase() %>
                    </div>

                    <h2 class="fw-bold">
                        <%= currUser.username.split('@')[0] %>
                    </h2>

                    <p class="text-muted">
                        gmail: <%= currUser.email %>
                    </p>

                </div>

                <hr>

                <!-- Account Info -->
                <div class="row text-center">

                    <div class="col-md-4 mb-3">
                        <h5 class="fw-bold">Joined</h5>

                        <p>
                            <%= currUser.createdAt 
                                ? currUser.createdAt.toDateString()
                                : "Recently" %>
                        </p>
                    </div>

                    <div class="col-md-4 mb-3">
                        <h5 class="fw-bold">Listings</h5>
                        <p>0</p>
                    </div>

                    <div class="col-md-4 mb-3">
                        <h5 class="fw-bold">Bookings</h5>
                        <p>0</p>
                    </div>

                </div>

                <hr>

                <!-- Future Section -->
                <div>

                    <h4 class="fw-bold mb-3">
                        Upcoming Trips
                    </h4>

                    <!-- Display Bookings -->
                    <div class="alert alert-info rounded-3">
                        <% if(bookings.length > 0){ %>

                            <div class="row">

                                <% bookings.forEach((booking) => { %>

                                    <!-- <div class="col-md-6 mb-4">

                                        <div class="card shadow-sm border-0 rounded-4">

                                            <img 
                                                src="<%= booking.listing.image.url %>"
                                                class="card-img-top"
                                                style="height:220px; object-fit:cover;"
                                            >

                                            <div class="card-body ms-5">

                                                <h5 class="fw-bold mt-3">
                                                    <%= booking.listing.title %>
                                                </h5>

                                                <p class="text-muted mb-1">
                                                    <%= booking.listing.location %>,
                                                    <%= booking.listing.country %>
                                                </p>

                                                <hr>

                                                <p>
                                                    <b>Check In:</b>
                                                    <%= booking.checkIn.toLocaleDateString("en-GB", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric"
                                                    }) %>
                                                </p>

                                                <p>
                                                    <b>Check Out:</b>
                                                    <%= booking.checkOut.toLocaleDateString("en-GB", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric"
                                                    }) %>
                                                </p>

                                                <p>
                                                    <b>Guests:</b>

                                                    <%= booking.guests %>
                                                </p>
                                                <p>
                                                    <b>Total Paid:</b>

                                                    ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                                                </p>
                                                <p>
                                                    <b>Status:</b>

                                                    <span class="badge bg-success">
                                                        <%= booking.status %>
                                                    </span>
                                                </p>

                                                <form
                                                    action="/bookings/<%= booking._id %>?_method=DELETE"
                                                    method="POST"
                                                    onsubmit="return confirm('Cancel this booking?')"
                                                >
                                                    <button class="btn btn-danger btn-sm mb-3">
                                                        Cancel Booking
                                                    </button>
                                                </form>

                                            </div>

                                        </div>

                                    </div> -->

                                    <div class="col-lg-6 col-md-12 mb-4">

                                        <div class="card booking-card border-0 shadow-sm rounded-4 overflow-hidden h-100">

                                            <img
                                                src="<%= booking.listing.image.url %>"
                                                class="card-img-top"
                                                style="height:250px; object-fit:cover;"
                                                alt="<%= booking.listing.title %>"
                                            >

                                            <div class="card-body p-4">

                                                <h5 class="fw-bold mb-1">
                                                    <%= booking.listing.title %>
                                                </h5>

                                                <p class="text-muted mb-3">
                                                    <%= booking.listing.location %>,
                                                    <%= booking.listing.country %>
                                                </p>

                                                <hr>

                                                <div class="booking-details">

                                                    <div class="detail-row">
                                                        <span><b>Check In : </b></span>

                                                        <span>
                                                            <%= booking.checkIn.toLocaleDateString("en-GB", {
                                                                day:"2-digit",
                                                                month:"short",
                                                                year:"numeric"
                                                            }) %>
                                                        </span>
                                                    </div>

                                                    <div class="detail-row">
                                                        <span><b>Check Out : </b></span>

                                                        <span>
                                                            <%= booking.checkOut.toLocaleDateString("en-GB", {
                                                                day:"2-digit",
                                                                month:"short",
                                                                year:"numeric"
                                                            }) %>
                                                        </span>
                                                    </div>

                                                    <div class="detail-row">
                                                        <span><b>Guests : </b></span>

                                                        <span>
                                                            <%= booking.guests %>
                                                        </span>
                                                    </div>

                                                    <div class="detail-row border-0">
                                                        <span class="fw-bold">
                                                            <b>Total Paid : </b>
                                                        </span>

                                                        <span class="fw-bold text-success">
                                                            ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                                                        </span>
                                                    </div>

                                                </div>

                                                <div class="mt-4">

                                                    <div class="d-flex justify-content-between align-items-center">

                                                        <span class="badge rounded-pill bg-success px-3 py-2">
                                                            <%= booking.status %>
                                                        </span>

                                                        <button
                                                            type="button"
                                                            class="btn btn-outline-danger rounded-pill px-3"
                                                            onclick="toggleConfirm('<%= booking._id %>')"
                                                        >
                                                            Cancel Booking
                                                        </button>

                                                    </div>

                                                    <div
                                                        id="confirm-<%= booking._id %>"
                                                        class="confirm-box mt-3"
                                                    >
                                                        <div class="alert alert-danger d-flex justify-content-between align-items-center mb-0">

                                                            <span>
                                                                Are you sure you want to cancel this booking?
                                                            </span>

                                                            <form
                                                                action="/bookings/<%= booking._id %>?_method=DELETE"
                                                                method="POST"
                                                            >
                                                                <button
                                                                    type="submit"
                                                                    class="btn btn-danger btn-sm"
                                                                >
                                                                    Yes, Cancel
                                                                </button>
                                                            </form>

                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>
                                <% }) %>

                            </div>

                        <% } else { %>

                            <div class="text-center py-5">

                                <h5 class="text-muted">
                                    No trips booked yet ✈️
                                </h5>

                                <p class="text-secondary">
                                    Start exploring amazing places and make your first booking.
                                </p>

                                <a href="/listings" class="btn btn-dark rounded-pill px-4">
                                    Explore Listings
                                </a>

                            </div>

                        <% } %>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>
    function toggleConfirm(id) {
        document
            .getElementById(`confirm-${id}`)
            .classList.toggle("show");
    }
</script>

<style>
    .booking-card{
        transition: all .3s ease;
    }

    .booking-card:hover{
        transform: translateY(-6px);
        box-shadow: 0 15px 35px rgba(0,0,0,.12);
    }

    .detail-row{
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:12px 0;
        border-bottom:1px solid #ececec;
    }

    .detail-row span:first-child{
        font-weight:600;
        color:#555;
    }

    .detail-row span:last-child{
        color:#222;
    }

    .confirm-box{
        max-height:0;
        overflow:hidden;
        transition:all .3s ease;
    }

    .confirm-box.show{
        max-height:150px;
    }
</style>