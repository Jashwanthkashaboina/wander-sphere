<% layout("/layouts/boilerplate") %>
<div class="login-page">

    <div class="login-card">
        <h2 class="text-center mb-4">Welcome back to WanderSphere</h2>
        <form method="POST" action="/login" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">User name</label>
                <input 
                    name="username"
                    type="text"
                    id="username"
                    placeholder="Enter your username"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">User Name Required!</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input 
                    name="password"
                    type="password"
                    id="password"
                    placeholder="Enter password"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">password Required!</div>
            </div>

            <button class="btn btn-dark w-100 mt-2"> Login </button>
            <div class="mt-3 text-center">
                <a href="/auth/google"
                class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2 mt-3 py-2">

                    <img src="https://developers.google.com/identity/images/g-logo.png" width="18">

                    Continue with Google
                </a>
            </div>

        </form>
    </div>

</div>
<script src="/js/authenticate.js"></script>